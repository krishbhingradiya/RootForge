# =================================================================
# RootForge Enterprise Backend Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER COMMIT .env TO VERSION CONTROL.
# =================================================================

# Server & Network
PORT=5005
NODE_ENV=development
HOST=0.0.0.0
CORS_ORIGIN=https://root-forge.vercel.app,http://localhost:5175,http://localhost:5173
FRONTEND_URL=https://root-forge.vercel.app
PUBLIC_BASE_URL=https://rootforge.onrender.com

# PostgreSQL Database (Supabase or Self-Hosted)
# Transaction pooler URL (Port 6543 on Supabase)
DATABASE_URL="postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Session pooler / Direct connection URL for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# AI Provider Configuration (Google Gemini / OpenAI / Demo)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=8192
AI_TIMEOUT_MS=12000
AI_FALLBACK_ON_ERROR=true
AI_LOG_PROMPTS=false

# Stage Analysis AI Feature Flags
AI_ENABLE_STAGE_ANALYSIS=true
AI_ENABLE_STAGE_SOLUTIONS=true
AI_ENABLE_STAGE_ARCHITECTURE=true
AI_ENABLE_STAGE_PROCESS=true

# Twilio Outbound AI Voice Agent (Backend Only - NEVER expose to frontend)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Verified mobile number for development test calls (Trial accounts only)
TWILIO_TEST_PHONE_NUMBER=+91xxxxxxxxxx
VOICE_AGENT_ENABLED=true
# Optional signature bypass for local development testing
BYPASS_TWILIO_SIGNATURE_DEV=false

# Brevo Transactional Email & OTP Verification (Backend Only)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=support@rootforge.com
BREVO_SENDER_NAME=RootForge
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Optional Real-Time Multilingual Voice Providers
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here
