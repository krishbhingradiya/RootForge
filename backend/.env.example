PORT=5005
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET="super-secret-enterprise-jwt-key-2026-solution-builder"
CORS_ORIGIN="http://localhost:5175"

# AI Provider Configuration
# Supported providers: "gemini", "openai", "demo"
# Default behavior is DEMO provider (zero external API keys required)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=45000
AI_FALLBACK_ON_ERROR=true
AI_LOG_PROMPTS=false

# Brevo Transactional Email Configuration (Backend Only - NEVER expose to frontend)
BREVO_API_KEY=your_real_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com
BREVO_SENDER_NAME=RootForge
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6


