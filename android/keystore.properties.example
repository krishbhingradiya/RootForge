# Example Android Release Signing Properties
# DO NOT COMMIT YOUR REAL PRODUCTION KEYSTORE OR PASSWORDS TO GIT!
# Copy this file to android/keystore.properties (which is git-ignored) or provide
# these values via CI/CD environment variables:
#   ANDROID_KEYSTORE_PATH
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD

RELEASE_STORE_FILE=../my-release-key.jks
RELEASE_STORE_PASSWORD=your_store_password_here
RELEASE_KEY_ALIAS=your_key_alias_here
RELEASE_KEY_PASSWORD=your_key_password_here
