# RootForge AI Solution Builder - Frontend Environment Example
# Copy to .env.local for local overrides

# In development on the Android Emulator, this defaults to http://10.0.2.2:5005 automatically.
# In web browser development, requests use relative /api proxied by Vite to http://127.0.0.1:5005.
VITE_API_URL=http://10.0.2.2:5005
